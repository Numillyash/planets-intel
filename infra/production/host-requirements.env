# Production host capability contract for /opt/planets-intel.
#
# This file is intentionally shell-compatible so maintenance/preflight scripts
# can source it directly. Keep host requirements separate from container/runtime
# requirements: normal production deploy must not require host Node.js or host
# Python 3.11.

HOST_BASH_MIN="4.2"
HOST_GIT_MIN="1.8"
HOST_DOCKER_MIN="24.0"
HOST_DOCKER_COMPOSE_MAJOR="2"

# Production currently has an old system Python. Host-side maintenance helpers
# must remain compatible with this baseline unless they explicitly execute in
# the backend container instead.
HOST_SYSTEM_PYTHON_MIN="3.6"

HOST_REQUIRED_DEPLOY_COMMANDS="bash git docker curl grep sed awk tail tee seq getent"
HOST_REQUIRED_NETWORK_COMMANDS="nmcli"
HOST_OPTIONAL_NETWORK_DIAGNOSTICS="dig nslookup"

# Runtime/build language versions belong to Docker images, not the host.
FRONTEND_BUILD_IMAGE="node:20-alpine"
BACKEND_RUNTIME_IMAGE="python:3.11-slim"
DATABASE_IMAGE="postgres:16"

# Production DNS facts captured on 2026-08-24. Direct UDP/53 to 8.8.8.8 timed
# out repeatedly on this host; 1.1.1.1 and 9.9.9.9 were verified reachable.
PRODUCTION_DNS_PRIMARY="1.1.1.1"
PRODUCTION_DNS_SECONDARY="9.9.9.9"
PRODUCTION_KNOWN_BAD_DNS="8.8.8.8"

# Docker BuildKit resolves base-image metadata even when some layers are cached,
# so registry DNS + HTTPS reachability is a production deploy prerequisite.
DOCKER_REGISTRY_HOST="registry-1.docker.io"
DOCKER_REGISTRY_URL="https://registry-1.docker.io/v2/"
